# Required environment variables
DATABASE_URL=postgres://user:password@host:5432/dbname
BETTER_AUTH_SECRET=replace_with_secure_random_value
BETTER_AUTH_URL=https://your-app.example.com
# Comma-separated list of admin emails (e.g. admin@example.com)
ADMIN_EMAILS=admin@example.com

# Optional Vercel runtime variables
# VERCEL_URL and VERCEL_PROJECT_PRODUCTION_URL are provided automatically on Vercel
